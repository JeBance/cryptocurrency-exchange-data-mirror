# ===========================================
# DATA MIRROR - Конфигурация
# ===========================================

# ----------------
# ОСНОВНЫЕ НАСТРОЙКИ
# ----------------

# Порт REST API (по умолчанию: 3030)
PORT=3030

# API ключ для защиты доступа
# Если не указан, генерируется автоматически при запуске
# Рекомендуется задать свой ключ для продакшена
API_KEY=your-secret-api-key-here

# ----------------
# ЛОГИРОВАНИЕ
# ----------------

# Уровень логирования: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Формат логов: true = красиво оформленные, false = JSON
LOG_PRETTY=true

# ----------------
# ХРАНИЛИЩЕ ДАННЫХ
# ----------------

# Тип хранилища: file или mongodb
STORAGE_TYPE=file

# Путь к папке для файлового хранилища (только для STORAGE_TYPE=file)
STORAGE_PATH=./data

# Максимальный размер файла в МБ (только для STORAGE_TYPE=file)
MAX_FILE_SIZE_MB=100

# URL подключения к MongoDB (обязательно для STORAGE_TYPE=mongodb)
# MONGO_URL=mongodb://localhost:27017

# Имя базы данных MongoDB (только для STORAGE_TYPE=mongodb)
MONGO_DB=data_mirror

# Размер пакета для буферизированной записи
BATCH_SIZE=1000

# Интервал сброса буфера в миллисекундах
FLUSH_INTERVAL_MS=5000

# ----------------
# RECONNECTION НАСТРОЙКИ
# ----------------

# Максимальное количество попыток переподключения
RECONNECT_MAX_RETRIES=10

# Базовая задержка переподключения в мс (экспоненциальный backoff)
RECONNECT_BASE_DELAY_MS=1000

# Максимальная задержка переподключения в мс
RECONNECT_MAX_DELAY_MS=60000

# ----------------
# BINANCE НАСТРОЙКИ
# ----------------

# Включить/выключить Binance
BINANCE_ENABLED=true

# Типы рынков: spot, futures, derivatives (через запятую)
BINANCE_MARKETS=spot,futures,derivatives

# Торговые пары (через запятую)
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT

# WebSocket URL (можно изменить для тестнета)
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# REST API URL (для проверки соединения)
BINANCE_REST_URL=https://api.binance.com

# ----------------
# BYBIT НАСТРОЙКИ
# ----------------

# Включить/выключить Bybit
BYBIT_ENABLED=true

# Типы рынков: spot, derivatives (через запятую)
BYBIT_MARKETS=spot,derivatives

# Торговые пары (через запятую)
BYBIT_SYMBOLS=BTCUSDT,ETHUSDT

# WebSocket URL (можно изменить для тестнета)
# Spot: wss://stream.bybit.com/v5/public/spot
# Futures: wss://stream.bybit.com/v5/public/linear
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/spot

# REST API URL (для проверки соединения)
BYBIT_REST_URL=https://api.bybit.com
